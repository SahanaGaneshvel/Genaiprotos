# Copy this file to .env and adjust. Never commit .env.

# --- Local LLM (Ollama) -------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Default model. On low-RAM / CPU-only machines use a smaller one, e.g.
#   OLLAMA_MODEL=qwen3.5:2b
# (run `ollama pull <model>` first)
OLLAMA_MODEL=qwen3.5:4b
# Conservative sampling for factual research work
OLLAMA_TEMPERATURE=0.1
# Context window passed to Ollama (tokens). Larger = more RAM.
OLLAMA_NUM_CTX=8192
# Seconds to wait for one LLM response (CPU inference can be slow)
OLLAMA_TIMEOUT=600

# --- Retrieval ------------------------------------------------------------
# Optional: raises GitHub search rate limit (10/min -> 30/min). Leave empty for public access.
GITHUB_TOKEN=
# Max sources kept per category (web / arxiv / github)
MAX_RESULTS_PER_SOURCE=4
# Cache retrieval results for this many hours (0 disables caching)
CACHE_TTL_HOURS=24
